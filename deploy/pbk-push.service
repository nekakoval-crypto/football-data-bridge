[Unit]
Description=PBK Web Push dispatcher
After=network-online.target pbk-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=pbk
Group=pbk
WorkingDirectory=/opt/pbk/repo
EnvironmentFile=-/etc/pbk/pbk.env
Environment=PBK_DB_PATH=/opt/pbk/data/pbk_unified.sqlite
Environment=PBK_PUSH_DATA_DIR=/opt/pbk/data
ExecStart=/opt/pbk/venv/bin/python /opt/pbk/repo/deploy/push_dispatch.py
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/pbk/data
